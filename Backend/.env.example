PORT=4000
JWT_SEC=replace_with_a_long_random_secret

# IBM watsonx.ai (keep your real API key in Backend/.env, never commit it)
WATSONX_AI_AUTH_TYPE=iam
WATSONX_AI_APIKEY=your_ibm_cloud_api_key
WATSONX_AI_SERVICE_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id
WATSONX_MODEL_ID=ibm/granite-4-h-small
